# Copy to .env and fill in for your host. Never commit .env.

# ── Your NAS ─────────────────────────────────────────────────────────────────
# Address of the NFS server holding the music library. Required -- there is
# deliberately no default, so this repo asserts nothing about your network.
NAS_ADDR=

# Path to the music share on that server. The default suits a Synology; change
# it if yours differs.
NAS_MUSIC_PATH=/volume1/Music

# ── Credentials ──────────────────────────────────────────────────────────────
# Kept here rather than in a config file, so a token never enters something
# that could be committed or copied into an image layer.
DISCOGS_USER_TOKEN=

# AcoustID issues two credentials and calls BOTH of them an "API key".
# That is the whole confusion, so read the URLs, not the names:
#
#   application key  register an app at https://acoustid.org/login
#                    identifies the program. Lookup uses this one.
#
#   submitter key    https://acoustid.org/api-key   <- yes, /api-key
#                    identifies your account. Submission uses this one.
#
# They are not interchangeable. A submitter key in ACOUSTID_API_KEY fails
# quietly — lookups just stop returning matches.

# Needed for the fingerprint tiers (6-7).
ACOUSTID_API_KEY=

# Reserved: massMusicTagger looks up but never submits, so nothing reads
# this yet. It has a home here so it is not put in ACOUSTID_API_KEY instead.
ACOUSTID_SUBMITTER_KEY=
# ── Host ─────────────────────────────────────────────────────────────────────
# Run as your own user so tagged files are not owned by root.
PUID=1000
PGID=1000
TZ=Europe/London

# ── WSL2 fallback ────────────────────────────────────────────────────────────
# Used only with compose.wsl.yaml, where NFS volumes do not work. Point these
# at wherever the share is already mounted on this host.
# massMusicTagger writes, so these must be writable.
INCOMING_DIR=/mnt/nas/music/incoming
SORTED_DIR=/mnt/nas/music/sorted
ARCHIVE_DIR=/mnt/nas/music/archive

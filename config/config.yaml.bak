# ─────────────────────────────────────────────────────────────────────────────
# massMusicTagger — installation configuration (sjb)
# ─────────────────────────────────────────────────────────────────────────────
#
# This is the main configuration file for this installation.
# Source-specific settings and credentials live in their own named files,
# Credentials live in credentials/*.yaml beside this file; every one of them
# is loaded automatically, so nothing needs listing here.
#
# This file is gitignored — never commit credentials.
# See conf/config_sample.yaml for the full annotated reference.
#
# Usage:
#   mmt


# ─────────────────────────────────────────────────────────────────────────────
common:
# ─────────────────────────────────────────────────────────────────────────────

  # Left unset on purpose: massMusicTagger builds it from its own version,
  # so it cannot go stale the way the pinned "1.0" here did.
  # user_agent: ""
  formats_file: ""
  source_dir: /incoming
  dest_dir:   /sorted
  watch_poll_interval: 30

# ─────────────────────────────────────────────────────────────────────────────
source:
  source_hints_file: source_hints.yaml
# ─────────────────────────────────────────────────────────────────────────────

  priority:
    - discogs
    - musicbrainz
    # existing_tags  -- disabled while validating the absorbed core. It is a
    # last-resort source that tags from what is already in the files, so a
    # release neither Discogs nor MusicBrainz matched still gets filed. That
    # masks match failures, which is exactly what we want to see right now.

  # Legacy keys for discogstagger3 compatibility
  name:    discogs


# ─────────────────────────────────────────────────────────────────────────────
naming:
# ─────────────────────────────────────────────────────────────────────────────


  # Windows/Samba profile: replaces characters illegal on NTFS/SMB shares
  char_profile: windows
  char_substitutions: ""   # empty = the packaged table, where char_profile looks up
  # format_codes named conf/format_codes.yaml, a path that does not resolve — the
  # packaged table is used, and a format_codes.yaml here would override it.
  # format_codes: conf/format_codes.yaml

  # Replace embedded slashes with hyphens rather than removing them
  path_sep_replacement: "-"
  control_replacement: ""

  # Preserve original capitalisation for all path segments
  case_dir:     preserve
  case_disc:    preserve
  case_song:    preserve
  case_va_song: preserve
  case_nfo:     preserve
  case_m3u:     preserve
  use_anv: false

  join_artists: ""
  variousartists: "Various Artists"

# ─────────────────────────────────────────────────────────────────────────────
artwork:
# ─────────────────────────────────────────────────────────────────────────────

  embed_coverart: true
  image_policy: prefer_larger
  image_source: musicbrainz

  use_folder_jpg: true
  download_only_cover: false

# ─────────────────────────────────────────────────────────────────────────────
archiving:
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────

  keep_original: true

  # Move source directory to archive after successful tagging
  source_action: move
  source_archive_dir: /archive
  source_move_template: "%source%/%albumartist%/%current_folder%"

  copy_other_files: true
  done_file: .done

# ─────────────────────────────────────────────────────────────────────────────
cue:
# ─────────────────────────────────────────────────────────────────────────────

  cue_done_dir: .cue
  parse_cue_files: true

# ─────────────────────────────────────────────────────────────────────────────
m4a:
# ─────────────────────────────────────────────────────────────────────────────

  convert_m4a_files: true
  alac_action: convert_to_flac
  aac_action: convert_to_ogg
  m4a_done_dir: .m4a

# ─────────────────────────────────────────────────────────────────────────────
conversion:
# ─────────────────────────────────────────────────────────────────────────────

  flac_compression_level: 8
  mp3_quality: 2
  ogg_quality: 9

# ─────────────────────────────────────────────────────────────────────────────
batch:
# ─────────────────────────────────────────────────────────────────────────────

  id_file: id.txt
  searchdiscogs: true
  tracklength_tolerance: 10.0
  title_similarity_threshold: 60
  workers: 4
  audit_log: /cache/audit.json

# ─────────────────────────────────────────────────────────────────────────────
cache:
# ─────────────────────────────────────────────────────────────────────────────

  directory: /cache/discogs
# ─────────────────────────────────────────────────────────────────────────────
tags:

  keep_tags: freedb_id
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
replaygain:
# ─────────────────────────────────────────────────────────────────────────────

  add_tags: true
  application: r128gain

# ─────────────────────────────────────────────────────────────────────────────
logging:
# ─────────────────────────────────────────────────────────────────────────────

  level: 20
  log_file: /cache/mmt.log
